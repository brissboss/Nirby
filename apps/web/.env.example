# Mapbox (required for the map)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# API URL (defaults to http://localhost:4000 in dev)
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Public upload URL (MinIO/S3/CDN). Needed so next/image can load POI photos.
# Defaults to local MinIO in next.config.ts; set this in staging/prod builds.
# NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/nirby-uploads-dev

# Sentry (optional in dev)
NEXT_PUBLIC_SENTRY_DSN=
