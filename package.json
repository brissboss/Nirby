{
  "name": "nirby",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:root": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "turbo test",
    "clean": "turbo clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "swagger-jsdoc": "^6.2.8"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.16.0",
      "jws": ">=3.2.3",
      "fast-xml-parser": ">=5.3.5",
      "path-to-regexp": "0.1.13",
      "flatted": ">=3.4.2",
      "picomatch@2": ">=2.3.2",
      "picomatch@4": ">=4.0.4",
      "lodash": ">=4.18.0",
      "defu": ">=6.1.5",
      "fast-uri": ">=3.1.2",
      "vite": "7.3.2"
    }
  }
}
