# Template for /opt/nirby/prod/.env on the VPS.
# Normally generated automatically by CI (sync-env.sh). Use this for manual setup.
#
# cp infra/prod/.env.example /opt/nirby/prod/.env && chmod 600 /opt/nirby/prod/.env

JWT_SECRET=
DB_PASSWORD=
DB_APP_PASSWORD=
RESEND_API_KEY=
GOOGLE_PLACES_API_KEY=
FRONTEND_URL=https://nirby.theobrissiaud.fr

EMAIL_VERIFICATION_TEMPLATE_ID_EN=
EMAIL_VERIFICATION_TEMPLATE_ID_FR=
EMAIL_PASSWORD_RESET_TEMPLATE_ID_EN=
EMAIL_PASSWORD_RESET_TEMPLATE_ID_FR=
EMAIL_ACCOUNT_DELETED_TEMPLATE_ID_EN=
EMAIL_ACCOUNT_DELETED_TEMPLATE_ID_FR=
EMAIL_COLLABORATOR_INVITE_TEMPLATE_ID_EN=
EMAIL_COLLABORATOR_INVITE_TEMPLATE_ID_FR=

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

SENTRY_DSN=

# Set by deploy scripts (defaults shown)
DEPLOY_API_SHA=latest
DEPLOY_WEB_SHA=latest
BACKUP_POLICY=always
KEEP_IMAGES=5
